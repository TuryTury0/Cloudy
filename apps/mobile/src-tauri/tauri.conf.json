{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyTask",
  "version": "0.2.0",
  "identifier": "com.anytask.mobile",
  "build": {
    "beforeDevCommand": "npm run dev -w @anytask/mobile",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build -w @anytask/mobile",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnyTask",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.icns",
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  }
}
