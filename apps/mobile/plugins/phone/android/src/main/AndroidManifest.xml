<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Setting alarms and timers in the phone's clock app (a normal permission: no question to the user). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ only lists other apps that are declared here: the launchable ones. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11+ finds the speech recognition screen only when it is declared here. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.anytask.phone.NotificationService"
            android:label="AnyTask"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
